{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Iringa Dating - React Native client",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "test": "jest --passWithNoTests",
    "apk": "cd android && gradlew.bat assembleRelease"
  },
  "//": "react-native is pinned to 0.76.5, so every native library is pinned to an exact version from the same era. Caret ranges resolve to releases that require React Native 0.78+ and fail at codegen time (for example react-native-screens 4.28 and react-native-reanimated 3.19).",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-firebase/app": "21.6.1",
    "@react-native-firebase/messaging": "21.6.1",
    "@react-navigation/bottom-tabs": "7.2.0",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "@tanstack/react-query": "5.62.0",
    "axios": "1.7.9",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-device-info": "14.0.1",
    "react-native-gesture-handler": "2.21.2",
    "react-native-image-picker": "8.1.0",
    "react-native-keychain": "9.2.1",
    "react-native-maps": "1.18.0",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.10.1",
    "socket.io-client": "4.8.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^15.0.1",
    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native-community/cli-platform-ios": "^15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
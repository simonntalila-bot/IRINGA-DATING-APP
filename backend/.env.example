# ---------- Core ----------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Public base URL of the API (used for deep links / share links)
APP_PUBLIC_URL=http://localhost:4000

# ---------- Database ----------
DATABASE_URL=postgresql://iringa:iringa_dev_password@localhost:5432/iringa_dating?schema=public

# ---------- Redis (optional: app falls back to in-memory cache when empty) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_chars_random_development_secret
JWT_REFRESH_SECRET=CHANGE_ME_another_min_32_chars_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Protects phone/WhatsApp numbers at rest (AES-256-GCM) and builds the lookup
# index (HMAC). Generate with the same command as JWT_SECRET.
# Losing this key means losing every stored contact number.
PHONE_ENCRYPTION_KEY=CHANGE_ME_phone_encryption_key_32_chars_plus

# ---------- Media: Cloudflare R2 (S3 compatible) ----------
# Never exposed to the mobile client. Mobile only receives short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=iringa-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=900
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_AUDIO_BYTES=26214400

# Local disk fallback for development when R2 is not configured
MEDIA_LOCAL_DRIVER=local
MEDIA_LOCAL_DIR=./uploads

# ---------- Push notifications: Firebase Cloud Messaging ----------
# Path to a service-account JSON file. Never commit it.
FCM_SERVICE_ACCOUNT_PATH=
FCM_DRY_RUN=true

# ---------- Location / geography ----------
# Supported region is data-driven (see SupportedRegion table). This is only the
# centre point used for the first-run sanity check and for the default map view.
IRINGA_CENTER_LAT=-7.7669
IRINGA_CENTER_LNG=35.2313
# Maximum distance (km) used by discovery when the user has no location set
DISCOVERY_DEFAULT_RADIUS_KM=50
# How often a client may report a new area (seconds). Server rejects faster updates.
LOCATION_MIN_UPDATE_INTERVAL_SECONDS=900
# Geofence radius used when an admin does not define one (metres)
GEOFENCE_DEFAULT_RADIUS_M=150

# ---------- Compatibility scoring weights (admin-tunable later) ----------
COMPAT_WEIGHT_GOAL=30
COMPAT_WEIGHT_DISTANCE=20
COMPAT_WEIGHT_INTERESTS=25
COMPAT_WEIGHT_AGE=15
COMPAT_WEIGHT_LANGUAGE=5
COMPAT_WEIGHT_ACTIVITY=5

# ---------- Payments (provider abstraction; no real keys here) ----------
# mock | generic | mpesa
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
PAYMENT_REFERENCE_PREFIX=pay_
# Generic/aggregator gateway (PAYMENT_PROVIDER=generic)
PAYMENT_GATEWAY_CHECKOUT_URL=
PAYMENT_GATEWAY_CALLBACK_URL=

# ---------- M-Pesa (Safaricom Daraja, PAYMENT_PROVIDER=mpesa) ----------
# Sandbox base URL. Production uses https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSCODE=
# Must be a public HTTPS URL registered in the Daraja portal.
MPESA_CALLBACK_URL=

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Admin bootstrap (seed only) ----------
ADMIN_EMAIL=admin@iringadating.local
ADMIN_PASSWORD=ChangeMe_Admin_123
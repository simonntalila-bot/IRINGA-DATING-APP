}

model PostMedia {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @map("post_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid
  position Int    @default(0)

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("post_media")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}

// ---------------------------------------------------------------------------
// Dates & safety
// ---------------------------------------------------------------------------

model DatePlan {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  placeId        String?  @map("place_id") @db.Uuid
  placeName      String   @map("place_name") @db.VarChar(160)
  placeLat       Float?   @map("place_lat")
  placeLng       Float?   @map("place_lng")
  scheduledFor   DateTime @map("scheduled_for")
  note           String?  @db.VarChar(500)
  status         String   @default("PENDING") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("DatePlanCreator", fields: [createdById], references: [id], onDelete: Cascade)
  place          LocationPlace?        @relation(fields: [placeId], references: [id], onDelete: SetNull)
  participants   DatePlanParticipant[]
  checkIns       DateCheckIn[]
  safetyContacts SafetyContact[]

  @@index([conversationId, scheduledFor])
  @@map("date_plans")
}

model DatePlanParticipant {
  datePlanId String    @map("date_plan_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  acceptedAt DateTime? @map("accepted_at")

  datePlan DatePlan @relation(fields: [datePlanId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([datePlanId, userId])
  @@map("date_plan_participants")
}

model DateCheckIn {
  id         String   @id @default(uuid()) @db.Uuid
  datePlanId String   @map("date_plan_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")

  datePlan DatePlan @relation(fields: [datePlanId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([datePlanId, type])
  @@map("date_check_ins")
}

// Safety contact chosen by the user. The app never shares GPS automatically:
// check-ins are reminders, and the trusted contact is only notified if the
// user enabled it and the date is overdue.
model SafetyContact {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  contactUserId   String?  @map("contact_user_id") @db.Uuid
  name            String   @db.VarChar(120)
  phone           String   @db.VarChar(40)
  isPrimary       Boolean  @default(false) @map("is_primary")
  notifyOnOverdue Boolean  @default(true) @map("notify_on_overdue")
  createdAt       DateTime @default(now()) @map("created_at")

  user        User       @relation("SafetyContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  contactUser User?      @relation("SafetyContactTarget", fields: [contactUserId], references: [id], onDelete: SetNull)
  datePlans   DatePlan[]

  @@index([userId])
  @@map("safety_contacts")
}

// ---------------------------------------------------------------------------
// Subscriptions, payments, boosts
// ---------------------------------------------------------------------------

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  tier               SubscriptionTier   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  provider           String?            @db.VarChar(40)
  providerRef        String?            @map("provider_ref") @db.VarChar(160)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  cancelledAt        DateTime?          @map("cancelled_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentItem PaymentItem?

  @@index([userId, status])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  type           PaymentType
  provider       String        @db.VarChar(40)
  providerRef    String?       @unique @map("provider_ref") @db.VarChar(160)
  providerTxId   String?       @map("provider_tx_id") @db.VarChar(160)
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(80)
  amountMinor    Int           @map("amount_minor")
  currency       String        @default("TZS") @db.Char(3)
  status         PaymentStatus @default(PENDING)
  failureReason  String?       @map("failure_reason") @db.VarChar(255)
  metadata       Json?
  paidAt         DateTime?     @map("paid_at")
  refundedAt     DateTime?     @map("refunded_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PaymentItem[]

  @@index([userId, status, createdAt])
  @@index([type, status])
  @@map("payments")
}

/// What a payment bought. One payment can contain several items, and each item
/// is granted its own entitlement. This is the join that makes "one payment =
/// one contact unlock" enforceable.
model PaymentItem {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @map("payment_id") @db.Uuid
  productType ProductType   @map("product_type")
  productId   String?       @map("product_id") @db.VarChar(64)
  amountMinor Int           @map("amount_minor")
  currency    String        @default("TZS") @db.Char(3)
  status      PaymentStatus @default(PENDING)
  deliveredAt DateTime?     @map("delivered_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contactUnlock  ContactUnlock?
  videoPurchase  VideoPurchase?
  subscriptionId String?        @unique @map("subscription_id") @db.Uuid
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  boostId        String?        @unique @map("boost_id") @db.Uuid
  boost          Boost?         @relation(fields: [boostId], references: [id], onDelete: SetNull)
  entitlement    Entitlement?

  @@index([paymentId])
  @@index([productType, productId])
  @@map("payment_items")
}

model Boost {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  minutes       Int      @default(30)
  startedAt     DateTime @default(now()) @map("started_at")
  endsAt        DateTime @map("ends_at")
  impressions   Int      @default(0)
  profileVisits Int      @default(0) @map("profile_visits")
  likesReceived Int      @default(0) @map("likes_received")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentItem PaymentItem?

  @@index([userId, endsAt])
  @@map("boosts")
}

// ---------------------------------------------------------------------------
// Monetisation: contact unlock + premium media
//
// SAFETY MODEL (business rules 2, 3, 4, 5, 14)
//   A payment buys access to an APPROVED contact feature. It never buys a
//   person, never overrides the owner's consent, and the product itself may not
//   be used to advertise paid sexual services (enforced by the content policy
//   checks + report reasons + moderation).
// ---------------------------------------------------------------------------

model ContactUnlock {
  id               String              @id @default(uuid()) @db.Uuid
  buyerId          String              @map("buyer_id") @db.Uuid
  profileOwnerId   String              @map("profile_owner_id") @db.Uuid
  paymentItemId    String              @unique @map("payment_item_id") @db.Uuid
  amountMinor      Int                 @map("amount_minor")
  currency         String              @default("TZS") @db.Char(3)
  status           ContactUnlockStatus @default(ACTIVE)
  phoneUnlocked    Boolean             @default(true) @map("phone_unlocked")
  whatsappUnlocked Boolean             @default(false) @map("whatsapp_unlocked")
  refundedAt       DateTime?           @map("refunded_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  expiresAt        DateTime?           @map("expires_at")

  buyer        User        @relation("ContactBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  profileOwner User        @relation("ContactOwner", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  paymentItem  PaymentItem @relation(fields: [paymentItemId], references: [id], onDelete: Cascade)

  /// One buyer pays once per target profile. This constraint is what makes
  /// "already unlocked -> do not charge again" a database guarantee rather
  /// than an application check that can be forgotten.
  @@unique([buyerId, profileOwnerId])
  @@index([profileOwnerId, status])
  @@map("contact_unlocks")
}

model VideoCategory {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique @db.VarChar(60)
  labelEn   String  @map("label_en") @db.VarChar(80)
  labelSw   String  @map("label_sw") @db.VarChar(80)
  emoji     String? @db.VarChar(64)
  isAdult   Boolean @default(true) @map("is_adult")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  videos PremiumVideo[]

  @@map("video_categories")
}

model PremiumVideo {
  id             String      @id @default(uuid()) @db.Uuid
  title          String      @db.VarChar(160)
  description    String?     @db.VarChar(1000)
  categoryId     String      @map("category_id") @db.Uuid
  thumbnailKey   String?     @map("thumbnail_key") @db.VarChar(400)
  videoKey       String      @map("video_key") @db.VarChar(400)
  bucket         String      @db.VarChar(80)
  durationSec    Int?        @map("duration_sec")
  sizeBytes      Int?        @map("size_bytes")
  mimeType       String      @default("video/mp4") @map("mime_type") @db.VarChar(120)
  priceMinor     Int         @default(100000) @map("price_minor")
  currency       String      @default("TZS") @db.Char(3)
  isPremium      Boolean     @default(true) @map("is_premium")
  status         VideoStatus @default(DRAFT)
  /// Set by moderation when the video is pulled for policy violations.
  moderationNote String?     @map("moderation_note") @db.VarChar(500)
  publishedAt    DateTime?   @map("published_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  category  VideoCategory   @relation(fields: [categoryId], references: [id])
  purchases VideoPurchase[]

  @@index([status, categoryId])
  @@index([isPremium])
  @@map("premium_videos")
}

model VideoPurchase {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  videoId       String              @map("video_id") @db.Uuid
  paymentItemId String              @unique @map("payment_item_id") @db.Uuid
  amountMinor   Int                 @map("amount_minor")
  currency      String              @default("TZS") @db.Char(3)
  status        VideoPurchaseStatus @default(ACTIVE)
  refundedAt    DateTime?           @map("refunded_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       PremiumVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  paymentItem PaymentItem  @relation(fields: [paymentItemId], references: [id], onDelete: Cascade)

  /// Same rule as contact unlock: buying twice is impossible at the database level.
  @@unique([userId, videoId])
  @@index([videoId, status])
  @@map("video_purchases")
}

model Entitlement {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  type          EntitlementType
  /// Target of the entitlement: profile owner id, video id, plan id...
  resourceId    String?         @map("resource_id") @db.VarChar(64)
  paymentItemId String?         @unique @map("payment_item_id") @db.Uuid
  startsAt      DateTime        @default(now()) @map("starts_at")
  expiresAt     DateTime?       @map("expires_at")
  revokedAt     DateTime?       @map("revoked_at")
  revokedReason String?         @map("revoked_reason") @db.VarChar(255)
  createdAt     DateTime        @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentItem PaymentItem? @relation(fields: [paymentItemId], references: [id], onDelete: SetNull)

  @@unique([userId, type, resourceId])
  @@index([userId, type])
  @@map("entitlements")
}

// ---------------------------------------------------------------------------
// Live location sharing - consent driven, never automatic
// ---------------------------------------------------------------------------

/// A request for temporary live location. Payment does NOT create this: the
/// requester asks, and the profile owner decides.
model LocationShare {
  id               String              @id @default(uuid()) @db.Uuid
  ownerId          String              @map("owner_id") @db.Uuid
  requesterId      String              @map("requester_id") @db.Uuid
  status           LocationShareStatus @default(PENDING)
  requestedMinutes Int                 @map("requested_minutes")
  note             String?             @db.VarChar(255)
  decidedAt        DateTime?           @map("decided_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  owner      User                     @relation("LocationShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requester  User                     @relation("LocationShareRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  permission LocationSharePermission?

  @@unique([ownerId, requesterId])
  @@index([requesterId, status])
  @@map("location_shares")
}

/// The active grant produced by accepting a LocationShare. This row is what
/// the recipient's device reads, and it carries its own hard expiry.
model LocationSharePermission {
  id          String    @id @default(uuid()) @db.Uuid
  shareId     String    @unique @map("share_id") @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at")
  expiresAt   DateTime  @map("expires_at")
  endedAt     DateTime? @map("ended_at")
  endReason   String?   @map("end_reason") @db.VarChar(120)
  createdAt   DateTime  @default(now()) @map("created_at")

  share     LocationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  owner     User          @relation("SharePermissionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient User          @relation("SharePermissionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, endedAt])
  @@index([expiresAt])
  @@map("location_share_permissions")
}

// ---------------------------------------------------------------------------
// Audited access to sensitive data
// ---------------------------------------------------------------------------

/// Written whenever an admin (or the owner) reads contact data, and whenever a
/// contact/video entitlement is granted or revoked.
model SensitiveAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorRole String?  @map("actor_role") @db.VarChar(40)
  subjectId String?  @map("subject_id") @db.Uuid
  action    String   @db.VarChar(80)
  reason    String?  @db.VarChar(255)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@map("sensitive_access_logs")
}

/// One call attempt. Media flows peer-to-peer over WebRTC; we only keep the
/// signalling handshake and an audit trail of who called whom, so the app can
/// offer "Block/report during call" without recording any content.
model CallSession {
  id             String     @id @default(uuid()) @db.Uuid
  callerId       String     @map("caller_id") @db.Uuid
  calleeId       String     @map("callee_id") @db.Uuid
  conversationId String?    @map("conversation_id") @db.Uuid
  type           CallType   @default(VOICE)
  status         CallStatus @default(RINGING)
  sdpOffer       String?    @map("sdp_offer") @db.Text
  sdpAnswer      String?    @map("sdp_answer") @db.Text
  /// Accumulated ICE candidates, kept so a reconnecting peer can resume.
  iceCandidates  Json?      @map("ice_candidates")
  ringTimeoutAt  DateTime   @map("ring_timeout_at")
  acceptedAt     DateTime?  @map("accepted_at")
  endedAt        DateTime?  @map("ended_at")
  endReason      String?    @map("end_reason") @db.VarChar(120)
  createdAt      DateTime   @default(now()) @map("created_at")

  caller User @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status, ringTimeoutAt])
  @@map("call_sessions")
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @unique @map("user_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(120)
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  logs AdminLog[]

  @@map("admin_users")
}

model AdminLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(120)
  meta       Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("admin_logs")
}
